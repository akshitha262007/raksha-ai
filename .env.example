# RAKSHA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate credentials.
# Never commit actual secret keys to git repositories.

# ==============================================================================
# FIREBASE WEB PUSH NOTIFICATION CONFIGURATION
# ==============================================================================

# Client-Side Public Firebase Configuration (Required for browser registration)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=raksha-ai-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=raksha-ai-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=raksha-ai-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_app_id:web:your_web_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_public_vapid_key

# Server-Side Firebase Credentials (Required for Netlify FCM dispatch)
# Option A: Server Key (Legacy FCM Key)
FIREBASE_SERVER_KEY=your_firebase_cloud_messaging_server_key

# Option B: Admin Service Account Credentials (FCM v1)
FIREBASE_PROJECT_ID=raksha-ai-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@raksha-ai-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"

# ==============================================================================
# SMS PROVIDER CONFIGURATION (Twilio Integration)
# ==============================================================================
SMS_ENABLED=true
SMS_TEST_MODE=true
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here
