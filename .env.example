# RAKSHA AI — SMS PROVIDER ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate credentials to enable real SMS testing.
# Never commit actual secret keys to git repositories.

# Enable Real SMS sending (Set to 'true' once credentials are added)
SMS_ENABLED=false

# Test Mode Flag (Required for /api/test-sms endpoint)
SMS_TEST_MODE=true

# Supported SMS providers: 'twilio' or 'generic'
SMS_PROVIDER=twilio

# Twilio Credentials (or generic provider environment variables)
SMS_ACCOUNT_ID=your_twilio_account_sid_here
SMS_API_SECRET=your_twilio_auth_token_here
SMS_SENDER_ID=your_twilio_phone_number_here
SMS_API_KEY=your_api_key_here
